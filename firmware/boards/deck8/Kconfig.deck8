# Deck-8 Rev A: Raytac MDBT50Q-1MV2 (nRF52840) macro pad

config BOARD_DECK8
    select SOC_NRF52840_QIAA
    select ZMK_BOARD_COMPAT if BOARD_DECK8_NRF52840_ZMK
    imply RETAINED_MEM if BOARD_DECK8_NRF52840_ZMK
    imply RETENTION if BOARD_DECK8_NRF52840_ZMK
    imply RETENTION_BOOT_MODE if BOARD_DECK8_NRF52840_ZMK
